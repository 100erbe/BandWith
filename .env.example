# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Places API (New) - Optional. If unset, automatically uses free OpenStreetMap / Photon geocoder.
VITE_GOOGLE_PLACES_API_KEY=

# Development only: run on local sample data instead of Supabase (any sign-in opens the demo account).
# Also turns on automatically in `npm run dev` when the two Supabase variables above are missing.
# VITE_DEMO_MODE=true
